! make install-user-config copies this only if ~/.config/X11/machine.resources is missing.
! Keep the installed file local to each machine; review font/DPI choices.
! dwm-session merges ~/.Xresources first, then this file.
Xft.dpi: 144

dwm.font: JetBrainsMono Nerd Font Mono:size=11
dmenu.font: JetBrainsMono Nerd Font Mono:size=11
st.font: JetBrainsMono Nerd Font Mono:size=11
